{
  "name": "oc-azure",
  "version": "1.0.3",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Azure for OpenCode agents: the Azure CLI in the agent's own shell with per-account sign-ins supplied per command, permissions by what each command does, SSH into VMs, costs, Graph, DevOps and AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-w-rs/oc-azure.git"
  },
  "homepage": "https://github.com/p-w-rs/oc-azure#readme",
  "bugs": {
    "url": "https://github.com/p-w-rs/oc-azure/issues"
  },
  "exports": {
    ".": "./plugin/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "plugin/*.ts",
    "plugin/*.tsx",
    "!plugin/*.test.ts",
    "!plugin/test*.ts",
    "dist/gui-experimental.cjs",
    "vendor",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "pixi.toml",
    "pixi.lock",
    "npm-shrinkwrap.json",
    "tsconfig.json",
    "vite.config.ts",
    "skill",
    "tools/pixi.toml",
    "tools/pixi.lock"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test plugin/*.test.ts scripts/*.test.ts",
    "build": "vite build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "oc-secure-kit": "file:vendor/oc-secure-kit-1.0.2.tgz"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.6",
    "@types/node": "24.10.0",
    "solid-js": "1.9.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15"
  }
}
